<div class="bg-sky-200 rounded-xl p-4">
  <h2 class="font-bold text-lg mb-3">CAMBIO DE TAMAÑO</h2>
  <div class="flex items-center gap-4">
    <div class="flex flex-col gap-1">
      <label class="text-sm">ALTURA</label>
      <input
        type="number"
        id="imgHeight"
        value="100"
        min="50"
        max="400"
        class="w-20 p-2 rounded-lg bg-gray-300"
      />
    </div>
    <img
      id="resizeImage"
      src="https://picsum.photos/seed/coffee/200/200"
      alt="Imagen de ejemplo"
      class="object-cover rounded-lg"
      style="width: 100px; height: 100px;"
    />
    <div class="flex flex-col gap-1">
      <label class="text-sm">ANCHURA</label>
      <input
        type="number"
        id="imgWidth"
        value="100"
        min="50"
        max="400"
        class="w-20 p-2 rounded-lg bg-gray-300"
      />
    </div>
  </div>
</div>

<script>
  const heightInput = document.getElementById("imgHeight");
  const widthInput = document.getElementById("imgWidth");
  const image = document.getElementById("resizeImage");

  function cambiarTamano() {
    if (!heightInput || !widthInput || !image) return;
    // @ts-expect-error
    const altura = heightInput.value;
    // @ts-expect-error
    const anchura = widthInput.value;

    image.style.height = altura + "px";
    image.style.width = anchura + "px";
  }

  if (heightInput) heightInput.addEventListener("input", cambiarTamano);
  if (widthInput) widthInput.addEventListener("input", cambiarTamano);
</script>
